# Public template only. Do not use this file as APP_ENV_FILE or as a container env_file.
# Copy the keys into a private file outside git (for example /tmp or the VPS secret store),
# replace every CHANGE_ME value, then point Compose at that file:
#   APP_ENV_FILE=/absolute/path/to/private.env docker compose -f infra/compose.yaml config
# APP_ENV=production rejects empty values and every placeholder listed below.

APP_ENV=development
API_PORT=8000
POSTGRES_DB=navigator
POSTGRES_USER=navigator
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
MAX_BOT_TOKEN=CHANGE_ME_MAX_BOT_TOKEN
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_USERNAME=t826_hakaton_max_bot
MAX_WEBHOOK_SECRET=CHANGE_ME_MAX_WEBHOOK_SECRET
PUBLIC_DOMAIN=zverybot.ru
PUBLIC_BASE_URL=https://zverybot.ru
MAX_LAUNCH_MAX_AGE_SECONDS=3600
CERTIFICATE_SIGNING_SECRET=CHANGE_ME_CERTIFICATE_SIGNING_SECRET
# Answers match the five questions in apps/miniapp/src/components/QuizModal.tsx.
QUIZ_ANSWER_KEY_JSON={"v1":{"q1":"a","q2":"b","q3":"c","q4":"a","q5":"b"}}
QUIZ_PASS_SCORE=70
# Path inside the bot container to a CA bundle, only if the host does not trust MAX's CA.
MAX_CA_BUNDLE_PATH=
REMINDER_POLL_SECONDS=60
REMINDER_LEAD_DAYS=1
